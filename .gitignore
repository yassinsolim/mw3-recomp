# ---- game data: extracted from the retail disc, never commit ----
# Anchored with a leading slash, and that matters: "mw2/" on its own matches
# a directory of that name at any depth, and the app's Kotlin lives in
# android/app/src/main/java/com/mw2/recomp. That rule silently swallowed the
# whole app once -- it built, installed, and died on a manifest pointing at
# classes that were never committed. Anchor anything meant for the root.
/mw2/
/mw3/
/cod4/
/aw/
/mw2-iso/
*.xex
*.xexp
*.pe
*.iso
*.god
*.ff
*.ffm
*.pak
*.bik

# ---- upstream tool checkout (121 MB + 6 submodules) ----
# Cloned and patched by build.sh and setup/setup.ps1; local changes live in patches/.
/XenonRecomp/

# ---- the portable tools setup/setup.ps1 downloads (JDK, SDK, LLVM, ...) ----
/.toolchain/

# ---- generated C++ (~2.2M lines, 64 MB) ----
/ppc/
/ppc_mw3/
/ppc_mw3_mp/
/ppc_cod4/
/ppc_cod4_mp/
/ppc_aw/
/ppc_aw_mp/
/ppc_aw_mp_tu17/

# ---- generated switch tables (XenonAnalyse output, rebuilt by build.sh) ----
config/mw2_switch_tables.toml
config/mw3_switch_tables.toml
config/mw3mp_switch_tables.toml
config/cod4_switch_tables.toml
config/cod4mp_switch_tables.toml
config/aw_switch_tables.toml
config/awmp_switch_tables.toml
config/awmp_switch_tables.tu17.toml
mw3_candidates.h

# ---- build artifacts ----
/build/
/build-tests/
/build-mw3*/
/build-release/
/build-win*/
# The checks' own build (tests/CMakeLists.txt), which needs none of the game:
# cmake -S tests -B build-tests -G Ninja
/out/

# ---- editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- generated runtime glue ----
runtime/kernel/stubs_generated.cpp
ppc/kernel_imports.txt
__pycache__/
*.pyc
/diagnosis/

# ---- the user's RenderDoc captures, hundreds of MB each ----
/captures/

# ---- saved games the runtime writes beside the binary ----
/saves/

# ---- the multiplayer executable's derived files (TITLE=mp ./build.sh) ----
/ppc_mp/
/build-mp/
/build-mp-release/
config/mw2mp_switch_tables.toml

# ---- the Android app's build output ----
android/build/
android/.gradle/
android/app/build/
android/local.properties
# android/gradle/wrapper/gradle-wrapper.jar
*.apk
*.aab
*.keystore

# ---- fetched by android/fetch_deps.sh, somebody else's code ----
third_party/libadrenotools/
# The Turnip driver the apps bundle, downloaded by the same script (and by
# setup/setup.ps1); a binary of somebody else's, never committed.
android/app/src/mw3/assets/drivers/
# The camouflage packs the multiplayer app bundles: the project's own is
# generated by tools/camo_gen.py at build time, and anybody else's is fetched
# or converted from the player's download (setup/setup.ps1); none is
# committed. Beside them, a copy of setup/camo-packs.json.
android/app/src/mw3/assets/camos/
android/app/src/mw3/assets/camo-packs.json
# PC camouflage mods the player downloaded, for setup to convert.
setup/camo-packs/

# ---- the native build's scratch directory ----
android/app/.cxx/
.cxx/
*.log
*.tmp
compile_commands.json

# ---- the disc version's derived files (VERSION=tu0 ./build.sh) ----
ppc_tu0/
ppc_mp_tu0/
build*-tu0/
config/*_switch_tables.tu0.toml

# ---- a development run's switches (docs/switches.md, "The settings file") ----
.env

# ---- local vendor tools and temporary binaries ----
tools/rad/
tools/xdvdfs_bin/
rad_installer.exe
*.txt
!CMakeLists.txt
!requirements.txt

# ---- local inspection dumps and test artifacts ----
/ucode_dump/
/*.png
/*.spv


# ---- iw4L port ----
iw4L/
/iw4L/
iw4L-cpp/build/
/iw4L-cpp/build/
build-iw4l*/
*.keystore
*.b64

# ---- the game code package (android/game): built from the disc, never committed ----
android/game/build/

# ---- the build tools' package and its probe (docs/ondevice-build.md) ----
android/toolchain/build/
android/toolchain-probe/build/
