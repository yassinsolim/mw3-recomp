<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's Bots entry (MainActivity.showBots): the count, the skill and the sides. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="4dp">

        <TextView
            style="@style/SettingHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bots_detail" />

        <TextView
            android:id="@+id/bot_count_label"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/bot_count"
            style="@style/SettingSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/bot_skill_label"
            style="@style/SettingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/bot_skill"
            style="@style/SettingSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bots_against_players"
            style="@style/SettingSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bots_against_players" />
    </LinearLayout>
</ScrollView>
