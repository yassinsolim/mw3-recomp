<?xml version="1.0" encoding="utf-8"?>
<!-- The guided setup (SetupActivity.kt): one step to a screen, each with its
     number, a plain sentence and one large button. The smaller buttons are
     other ways to do the same thing, or the way past an optional step; the
     bar and the lines under it are the build's. What failed is said in one
     sentence above Retry, with Share log underneath. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/setup_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF7A1A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/setup_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_sentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#C8D0D8"
            android:textSize="14sp" />

        <!-- What went wrong, in one sentence. -->
        <TextView
            android:id="@+id/setup_problem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:textColor="#FFB020"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/setup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressTint="#FF7A1A"
            android:indeterminateTint="#FF7A1A"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setup_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F0F6FC"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- While it builds: keep the app open, plug in the charger. -->
        <TextView
            android:id="@+id/setup_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_build_keep_open"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/setup_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_play_orange"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/setup_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_action"
            android:textAllCaps="false"
            android:textColor="#E8EAED"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/setup_tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_action"
            android:textAllCaps="false"
            android:textColor="#E8EAED"
            android:textSize="14sp"
            android:stateListAnimator="@null"
            android:visibility="gone" />

        <Button
            android:id="@+id/setup_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:text="@string/setup_share_log"
            android:textAllCaps="false"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
