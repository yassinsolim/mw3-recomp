<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <com.mw2.recomp.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/version_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8B949E"
            android:textSize="9sp"
            tools:text="v0.1.0-alpha" />

        <!-- Shown while the system holds the screen under the FPS limit
             (MainActivity.showDisplayHeld). -->
        <TextView
            android:id="@+id/display_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#FFB020"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#101828"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- Two columns (MainActivity.refresh). Left: the one large button,
             which is Play once the game is set up and the guided setup until
             then, a line of status under it, and what there is to play and
             to add. Right: the chosen entry's card, then help and settings.
             The groups a game is needed for are hidden until there is one. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/play"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2.4"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_play_orange"
                    android:gravity="center"
                    android:text="@string/play"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.1"
                    android:lineSpacingExtra="2dp"
                    android:stateListAnimator="@null" />

                <!-- One line: ready, or what is in the way. -->
                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="2dp"
                    android:paddingStart="4dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <LinearLayout
                    android:id="@+id/group_play"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="4"
                    android:orientation="vertical">

                    <TextView style="@style/MenuHeading"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/group_play" />
                    <Button android:id="@+id/other_app" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                    <!-- Modern Warfare 3's multiplayer only (MainActivity shows it). -->
                    <Button android:id="@+id/entry_bots" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:visibility="gone" />
                    <!-- Advanced Warfare with the player's own title update (MainActivity shows it). -->
                    <Button android:id="@+id/entry_zombies" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:text="@string/entry_zombies"
                        android:visibility="gone" />
                    <!-- Modern Warfare 3 with the player's own map packs that hold Special Ops levels (MainActivity shows it). -->
                    <Button android:id="@+id/entry_pack_levels" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:text="@string/entry_pack_levels"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_extras"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView style="@style/MenuHeading"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/group_extras" />
                    <Button android:id="@+id/entry_dlc" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:text="@string/entry_dlc" />
                    <Button android:id="@+id/entry_mods" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:text="@string/entry_mods" />
                    <Button android:id="@+id/entry_tu6" style="@style/MenuEntry"
                        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:text="@string/entry_tu6" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/direct_launch_switch"
                    style="@style/SettingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:paddingStart="12dp"
                    android:text="@string/direct_launch"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/detail_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wordmark"
                        android:textColor="#F0F6FC"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:background="#FF7A1A" />

                    <TextView
                        android:id="@+id/detail_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="6"
                        android:ellipsize="end"
                        android:text="@string/detail_default_text"
                        android:textColor="#B9BDC4"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <TextView style="@style/MenuHeading"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/group_help" />
                <Button android:id="@+id/driver" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/graphics_driver" />
                <Button android:id="@+id/settings" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/entry_settings" />
                <Button android:id="@+id/log" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/view_log" />
                <Button android:id="@+id/entry_report" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/entry_report" />
                <Button android:id="@+id/entry_updates" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/check_updates" />
                <!-- The screens the guided setup runs for the player: another
                     disc image, the files copied in, the game built again. -->
                <Button android:id="@+id/entry_repair" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/entry_repair" />
                <Button android:id="@+id/entry_quit" style="@style/MenuEntry"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:text="@string/quit_launcher" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#8B949E"
                android:textSize="9sp"
                android:lineSpacingExtra="1dp"
                android:fontFamily="sans-serif" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wordmark_recompiled"
                    android:textColor="#FF7A1A"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.14"
                    android:shadowColor="#FF7A1A"
                    android:shadowRadius="10"
                    android:shadowDx="0"
                    android:shadowDy="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/credit_line"
                    android:textColor="#FF7A1A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.2"
                    android:shadowColor="#FF7A1A"
                    android:shadowRadius="6"
                    android:shadowDx="0"
                    android:shadowDy="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/disclaimer"
                    android:textColor="#6E7681"
                    android:textSize="7sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hint_choose"
                    android:textColor="#6E7681"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
