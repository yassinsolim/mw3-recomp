<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vibration for the controller's rumble; the player can turn it off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reading the disc image the player supplies. On Android 13 and later
         a plain file path outside the app's own folders needs the manage
         permission; the app asks for it only when the player picks a file
         it cannot otherwise read, and works without it when the image sits
         in Android/data/<package>/files. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Self-update: downloading the next APK and installing it over this one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- System link between phones on the same network (MW2_NET_LINK). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice chat in Modern Warfare 3's multiplayer. Asked for only when the
         player turns voice chat on in Settings; the game runs without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The run's process has to stay wanted while the game is up, and for a
         process nobody is looking at a foreground service is the only way to
         say so (GameService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Building the game code on the device (GameBuildService.kt): the
         processor must not sleep under a build the player has walked away
         from, and its progress and its end are a notification, which Android
         13 shows only with the player's leave. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x400000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Modern Warfare 2's campaign and multiplayer as apps of their own each
         offer to start the other (MainActivity.otherApp): from Android 11 an
         app sees another only when it names it here. The last is the package
         the app with the whole game loads the recompiled code from
         (GameLibrary.kt). -->
    <queries>
        <package android:name="cod.modern.warfare2.sp" />
        <package android:name="cod.modern.warfare2.mp" />
        <package android:name="cod.modern.warfare2.sp.tu6" />
        <package android:name="cod.modern.warfare2.mp.tu6" />
        <package android:name="${gamePackage}" />
        <!-- The compiler and the recompiler, for building the game code here (Toolchain.kt). -->
        <package android:name="com.recomp.toolchain" />
    </queries>

    <application
        android:name=".MW2Application"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/Theme.MW2">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The run lives in its own process. It is ended by killing that
             process, which is the only way to stop a guest that is inside
             recompiled code, and it must not take the launcher with it. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|navigation|keyboard|touchscreen|smallestScreenSize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Between the campaign and the multiplayer: in the launcher's
             process, because its whole job is to outlive the run's and start
             the next one (HandOffActivity.kt). It shows nothing and is gone
             the moment the new run is up. -->
        <activity
            android:name=".HandOffActivity"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- In the run's own process, so the notification and the game share
             one: a service in the launcher's process would keep the wrong thing
             alive and let the :game process be killed anyway. Its type is
             "special use" because that is what a game session held open for a
             player who has stepped away is. -->
        <service
            android:name=".GameService"
            android:exported="false"
            android:process=":game"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A game session in progress" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".DriverActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".DlcActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".CamoPacksActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".BuildActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- The build of the game code, kept going with the app in the
             background (GameBuildService.kt), in the launcher's process. No
             type Android names fits a compiler at work for an hour; "data
             sync" is ended after six. -->
        <service
            android:name=".GameBuildService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compiling the game code from the player's own disc" />
        </service>

        <activity
            android:name=".FileBrowserActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>
</manifest>
