#version 450
// The driver self-test's compute shader: the renderer has one compute
// pipeline (display_table.cpp), and a driver that cannot run this one cannot
// run that.
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) buffer Data { uint values[]; } data;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    data.values[i] = data.values[i] * 3u + i + 1u;
}
