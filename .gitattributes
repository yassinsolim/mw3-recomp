# relay/tests/header.rs compares this file byte for byte with what cbindgen
# writes (LF), so a Windows checkout with core.autocrlf must not convert it.
relay/protocol.h text eol=lf
# cmd.exe misreads a batch file with LF endings (labels, multi-line blocks).
setup/*.cmd text eol=crlf
# git apply matches the patch's lines against XenonRecomp's LF sources; a
# CRLF checkout of the patch (core.autocrlf, Git for Windows' default) would
# match none of them.
*.patch text eol=lf
# Run by bash on the relay's host as it was checked out (docs/perf-reports.md):
# a CRLF checkout fails at its first line.
relay/perf-setup.sh text eol=lf
