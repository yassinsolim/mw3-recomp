// What Find Game offers Modern Warfare 3 on a relay, in the title's playlist
// format (docs/relay.md, "Playlists"). Written for this project: the maps and
// the script game types are the disc's own names, nothing else is the
// publisher's. Raise `version` when the file changes.
//
// Playlists are numbered from 1: the title's menu never lists playlist 0.
// None is `ranked`: this release of the title refuses the word, and a ranked
// match asks Xbox LIVE for arbitration, which nothing answers.
version 1

gametype tdm
name english "Team Deathmatch"
abbrv english "TDM"
script war
teambased

gametype ffa
name english "Free-for-all"
abbrv english "FFA"
script dm

gametype dom
name english "Domination"
abbrv english "DOM"
script dom
teambased

gametype kc
name english "Kill Confirmed"
abbrv english "KC"
script conf
teambased

playlist 1
name english "Team Deathmatch"
description english "Two teams. The first to the score limit wins."
minparty 1
maxparty 6
mp_alpha,tdm,1
mp_bootleg,tdm,1
mp_bravo,tdm,1
mp_carbon,tdm,1
mp_dome,tdm,1
mp_exchange,tdm,1
