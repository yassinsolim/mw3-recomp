// What Find Match offers Call of Duty 4 on a relay, in the title's playlist
// format (docs/relay.md, "Playlists"). Written for this project: the maps and
// the script game types are the disc's own names, nothing else is the
// publisher's. Raise `version` when the file changes.
version 1

gametype tdm
name english "Team Deathmatch"
script war
teambased

gametype ffa
name english "Free-for-all"
script dm

playlist 0
name english "Team Deathmatch"
description english "Two teams, most kills wins."
minparty 1
maxparty 9
mp_backlot,tdm,1
mp_bloc,tdm,1
mp_bog,tdm,1
mp_cargoship,tdm,1
mp_citystreets,tdm,1
mp_convoy,tdm,1
