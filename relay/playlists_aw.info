// What Find Match offers Advanced Warfare on a relay, in the title's playlist
// format (docs/relay.md, "Playlists"). Written for this project: the maps and
// the script game types are the disc's own names, nothing else is the
// publisher's. Raise `version` when the file changes.
//
// Playlists are numbered from 1: the title's menu never lists playlist 0.
// None is `ranked`: a ranked match asks Xbox LIVE for arbitration, which
// nothing answers.
//
// The categories at the end say which menu lists what (docs/AW-BRINGUP.md,
// "Exo Survival under Xbox LIVE, Combat Readiness Program"): TOP's own
// playlists are the multiplayer's Find Match, a SURVIVAL category Exo
// Survival's, and Combat Readiness Program takes the PRACTICE category's
// playlist. Without them every menu listed every playlist.
version 3

gametype tdm
name english "Team Deathmatch"
abbrv english "TDM"
script war
teambased

gametype ffa
name english "Free-for-all"
abbrv english "FFA"
script dm

gametype horde
name english "Exo Survival"
abbrv english "EXO"
script horde
teambased

playlist 1
name english "Team Deathmatch"
description english "Two teams. The first to the score limit wins."
minparty 1
maxparty 6
rule party_minplayers 2
mp_refraction,tdm,1
mp_lab2,tdm,1
mp_comeback,tdm,1
mp_laser2,tdm,1
mp_detroit,tdm,1
mp_greenband,tdm,1
mp_levity,tdm,1
mp_instinct,tdm,1
mp_recovery,tdm,1
mp_venus,tdm,1
mp_prison,tdm,1
mp_solar,tdm,1
mp_terrace,tdm,1

playlist 2
name english "Free-for-all"
description english "Every player for themselves."
minparty 1
maxparty 8
rule party_minplayers 2
mp_refraction,ffa,1
mp_lab2,ffa,1
mp_comeback,ffa,1
mp_laser2,ffa,1
mp_detroit,ffa,1
mp_greenband,ffa,1
mp_levity,ffa,1
mp_instinct,ffa,1
mp_recovery,ffa,1
mp_venus,ffa,1
mp_prison,ffa,1
mp_solar,ffa,1
mp_terrace,ffa,1

playlist 3
name english "Exo Survival"
description english "Up to four players against rounds of enemies."
minparty 1
maxparty 4
rule party_minplayers 2
mp_refraction,horde,1
mp_lab2,horde,1
mp_comeback,horde,1
mp_laser2,horde,1
mp_detroit,horde,1
mp_greenband,horde,1
mp_levity,horde,1
mp_instinct,horde,1
mp_recovery,horde,1
mp_venus,horde,1
mp_prison,horde,1
mp_solar,horde,1
mp_terrace,horde,1

playlist 4
name english "Combat Readiness Program"
description english "Team Deathmatch for practice, beside and against bots."
minparty 1
maxparty 6
// One: the title then starts without searching for a second player.
rule party_minplayers 1
// The mode is the title's practice round (its dvar practiceroundgame, which
// the menu sets): the host's scripts fill both teams with bots, three a
// side (practiceroundBotTeamLimit), but only when the lobby's bots are set
// to fill, which the publisher's own playlist must have said. Without this
// line the player was alone and the match was forfeited. The title takes
// the rule back when the lobby is left: a System Link game made after it
// has no bots of its own accord.
rule bot_AutoConnectDefault fill_open
mp_refraction,tdm,1
mp_lab2,tdm,1
mp_comeback,tdm,1
mp_laser2,tdm,1
mp_detroit,tdm,1
mp_greenband,tdm,1
mp_levity,tdm,1
mp_instinct,tdm,1
mp_recovery,tdm,1
mp_venus,tdm,1
mp_prison,tdm,1
mp_solar,tdm,1
mp_terrace,tdm,1

category TOP
include 1,2,B,C

category B
name english "Exo Survival"
categoryclass SURVIVAL
include 3

category C
name english "Combat Readiness Program"
categoryclass PRACTICE
include 4
